/*
 * rofi/bgselector/style.rasi — fullscreen wallpaper grid
 *
 * Palette comes from colors/current.rasi (managed by theme-sync.sh), so the
 * picker matches the active wallpaper's colorscheme like every other surface.
 */

@import "../colors/current.rasi"

configuration {
    show-icons: true;
    kb-cancel: "Escape";
    kb-accept-entry: "Return,KP_Enter";
    kb-row-left: "h,Left";
    kb-row-right: "l,Right";
    kb-row-down: "j,Down";
    kb-row-up: "k,Up";
    kb-page-prev: "Page_Up";
    kb-page-next: "Page_Down";
    kb-row-first: "Home";
    kb-row-last: "End";
}

* {
    background-color: transparent;
    separator: none;
    border: none;
    padding: 0px;
    margin: 0px;
    text-color: @fg;
}

window {
    background-color: @bg;
    fullscreen: true;
    border: 0px;
    separator: none;
}

mainbox {
    children: [listview];
    spacing: 0px;
    border: 0px;
    separator: none;
    padding: 0% 5%;
    expand: true;
    orientation: vertical;
    valign: 0.5;
}

listview {
    padding: 20px;
    spacing: 12px;
    columns: 7;
    lines: 1;
    flow: horizontal;
    fixed-height: true;
    scrollbar: false;
    cycle: true;
    border: 0px;
    separator: none;
    expand: true;
    valign: 0.5;
    halign: 0.5;
}

element {
    border-radius: 8px;
    children: [element-icon];
    background-color: @bg-alt;
    padding: 0px;
    margin: 0px;
}

element selected {
    border: 2px solid;
    border-color: @accent;
    border-radius: 8px;
    background-color: @bg-alt;
}

element-icon {
    size: 330px 509px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: @bg-alt;
    expand: true;
    scale: "fit";
}
