/*
 * rofi/config.rasi — minimal dark launcher
 *
 * Palette comes from colors/current.rasi, which theme-sync.sh re-points every
 * time the wallpaper changes, so the launcher always matches the desktop.
 *
 * Launch with: rofi -show drun   (Super+R)
 */

@import "colors/current.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
    disable-history: false;
    sorting-method: "fzf";
    tokenize: true;
    normalize-match: true;
    matching: "fuzzy";
    cycle: true;
    scroll-method: 0;
    terminal: "kitty";
    font: "FiraCode Nerd Font 11";
    kb-cancel: "Escape";
    kb-row-down: "Down,Control+j";
    kb-row-up: "Up,Control+k";
    kb-accept-entry: "Return,KP_Enter";
    kb-delete-entry: "Shift+Delete";
    kb-mode-next: "Tab";
    kb-mode-previous: "Shift+Tab";
    kb-row-first: "Home";
    kb-row-last: "End";
    kb-page-prev: "Page_Up";
    kb-page-next: "Page_Down";
}

* {
    background-color: transparent;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 640px;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @bg;
    padding: 8px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 6px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 14px;
    spacing: 8px;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    placeholder: "Search…";
    text-color: @fg;
    background-color: transparent;
    cursor: text;
}

listview {
    background-color: transparent;
    lines: 10;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    dynamic: true;
    layout: vertical;
}

element {
    children: [ element-icon, element-text ];
    background-color: transparent;
    border-radius: 8px;
    padding: 8px 10px;
    spacing: 10px;
}

element-icon {
    size: 22px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element normal.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}
