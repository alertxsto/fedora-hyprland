/* Material-Light — generated by theme-sync.sh, do not edit by hand */
* {
    bg:       #fafafa;
    bg-alt:   #e0e0e0;
    fg:       #000000;
    accent:   #39adb5;
    urgent:   #e53935;
    ok:       #91b859;
    warn:     #f6a434;
    info:     #39adb5;
    selected: #39adb5;
    border:   #39adb5;
    bg-glass:    #fafafaD9;
    surface:     #e0e0e099;
    surface-soft:#e0e0e04D;
    accent-soft: #39adb529;
    accent-dim:  #39adb573;
    border-soft: #39adb559;
    fg-dim:      #00000080;
}
