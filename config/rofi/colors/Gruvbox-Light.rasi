    bg:       #fbf1c7;
    bg-alt:   #d5c4a1;
    fg:       #3c3836;
    accent:   #b57614;
    urgent:   #cc241d;
    ok:       #98971a;
    warn:     #d79921;
    info:     #458588;
    selected: #b57614;
    border:   #b57614;
    bg-glass:    #fbf1c7D9;
    surface:     #d5c4a199;
    surface-soft:#d5c4a14D;
    accent-soft: #b5761429;
    accent-dim:  #b5761473;
    border-soft: #b5761459;
    fg-dim:      #3c383680;
}
